- name: Test Tomcat permissions
  shell: powershell
  run: |
    Write-Host "===== RUNNER IDENTITY ====="
    whoami
 
    Write-Host "===== USER DETAILS ====="
    whoami /user
 
    Write-Host "===== TOMCAT CURRENT STATUS ====="
    sc.exe query Tomcat9
 
    Write-Host "===== STOP TOMCAT USING SC.EXE ====="
    sc.exe stop Tomcat9
 
    if ($LASTEXITCODE -ne 0) {
        throw "sc.exe could not stop Tomcat9. Exit code: $LASTEXITCODE"
    }
 
    Write-Host "===== WAITING ====="
 
    $timeout = 60
    $elapsed = 0
 
    while ($elapsed -lt $timeout) {
        $output = sc.exe query Tomcat9
        $output | Write-Host
 
        if ($output -match "STOPPED") {
            Write-Host "Tomcat stopped successfully."
            break
        }
 
        Start-Sleep -Seconds 5
        $elapsed += 5
    }
 
    if ($elapsed -ge $timeout) {
        throw "Tomcat did not stop within 60 seconds."
    }
